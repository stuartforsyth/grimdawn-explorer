*.gdc
*.arz
*.arc
*.dbr

# Local machine config (discovered save/extractor paths)
data/config.local.json

# Generated knowledge base — rebuilt from the local install by data/updater.py,
# version-specific and large. Keep the folder (.gitkeep) but not the JSON.
data/kb/*.json
